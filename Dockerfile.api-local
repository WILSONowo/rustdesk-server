FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY artifacts/hbbs /usr/local/bin/hbbs
LABEL org.opencontainers.image.title="RustDesk hbbs with API-login TCP handshake" \
      org.opencontainers.image.version="1.1.16-beta1" \
      org.opencontainers.image.revision="73523b31cfd25d77dee862e6fc9f5e1fb5e485ef + local handshake patch"
WORKDIR /root
ENV HOME=/root
CMD ["hbbs"]
